# ==========================================
# Django Application Configuration
# ==========================================
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key
DJANGO_ALLOWED_HOSTS=portfolio.pvsairamsaketh.in,localhost,127.0.0.1,backend-service
CSRF_TRUSTED_ORIGINS=https://portfolio.pvsairamsaketh.in

# ==========================================
# PostgreSQL Database Settings
# ==========================================
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=generate-a-secure-db-password
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432

# ==========================================
# Deployment & Docker Hub Variables
# ==========================================
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_FRONTEND_REPOSITORY=your_dockerhub_username/portfolio-frontend
DOCKERHUB_BACKEND_REPOSITORY=your_dockerhub_username/portfolio-backend
PORTFOLIO_DOMAIN=portfolio.pvsairamsaketh.in
AWS_DEPLOY_HOST=3.25.73.147
AWS_DEPLOY_USER=ubuntu

# ==========================================
# SMTP Email Delivery (Gmail / Custom SMTP)
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# For Gmail: Use your Gmail address and generate a 16-character Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
CONTACT_RECEIVER_EMAIL=pvsairamsaketh@gmail.com
EMAIL_TIMEOUT=10

